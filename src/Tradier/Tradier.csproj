<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		
		<!-- NuGet Package Metadata -->
		<PackageId>Tradier.Client</PackageId>
		<Version>1.0.1</Version>
		<Authors>Pennyworth Labs</Authors>
		<Company>Pennyworth Labs</Company>
		<Description>A modern .NET SDK for the Tradier Brokerage API. Supports trading, market data, options chains with Greeks, account management, and streaming. Works with both production and sandbox (paper trading) environments.</Description>
		<PackageTags>tradier;trading;stocks;options;brokerage;api;sdk;finance;market-data;options-trading</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/blaunius/Tradier.NET</PackageProjectUrl>
		<RepositoryUrl>https://github.com/blaunius/Tradier.NET</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>v1.0.1: Removed static TradierConfig, simplified authentication to ApiKey-only, added StreamingService for real-time market data, improved DI support, added comprehensive constructor tests.</PackageReleaseNotes>
		
		<!-- Source Link -->
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		
		<!-- Assembly Info -->
		<AssemblyName>Tradier</AssemblyName>
		<RootNamespace>Tradier</RootNamespace>
		<Copyright>Copyright © 2025 Pennyworth Labs</Copyright>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
	</ItemGroup>

	<ItemGroup>
		<None Include="../../docs/README.md" Pack="true" PackagePath="/" />
	</ItemGroup>
</Project>
